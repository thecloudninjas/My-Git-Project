# Use an outdated version of Python
FROM python:3.13.2-slim

# Install a potentially outdated package (use of a package with known vulnerabilities)
RUN pip install --no-cache-dir flask==0.12.2

# Setting unsafe file permissions
RUN mkdir /app && chmod -R 777 /app

# Expose the default port for a web server (but no firewall)
EXPOSE 5000

# Use a weak user (or root) to run the application
USER root

# Copy insecure or sensitive files into the container
COPY ./config/ /app/config/

# Run an application with a hardcoded password or insecure config
COPY ./app.py /app/
RUN echo "app_password = 'hardcodedpassword'" >> /app/app.py

# Set the entrypoint to run the application
CMD ["python", "/app/app.py"]

